# Copy to .env.local and adjust.

# Laravel API base URL (no trailing slash)
VITE_API_URL=http://127.0.0.1:8000/api

# Pusher, for live notifications. Leave empty to disable them.
VITE_PUSHER_KEY=
VITE_PUSHER_CLUSTER=eu

# Stripe publishable key (pk_test_… in development). The secret key goes in the backend .env as STRIPE_SECRET.
VITE_STRIPE_KEY=

# Optional "fill demo account" button on the login page (local/dev only). Leave empty to hide it.
VITE_DEMO_EMAIL=
VITE_DEMO_PASSWORD=
